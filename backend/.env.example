# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Toggle: keep the whole product demoable with no external infra running.
# true  -> use seeded in-memory/mock data & mock AI + blockchain responses
# false -> require MongoDB, the AI service, and the blockchain node to be up
DEMO_MODE=true

# MongoDB Atlas (or any MongoDB instance)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bissaathi

# FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# Blockchain (Hardhat local node + deployed CertificateRegistry contract)
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Private key of the account that deployed the contract. When using a
# local Hardhat node, this can be Hardhat's well-known default Account #0
# key (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80) —
# it has no real funds and is safe to use, but only on a local ephemeral
# chain. NEVER put a real funded key here.
PRIVATE_KEY=

# Optional JWT secret, only needed if you enable the (currently unused)
# auth middleware for future officer/admin portals
JWT_SECRET=change-me-in-production
