# true -> pure keyword-retrieval demo pipeline, no GPU/Ollama/ChromaDB required
# false -> real pipeline: BGE-M3 embeddings + ChromaDB + Llama 3 8B via Ollama
AI_DEMO_MODE=true

# Where ingested demo source documents live
SOURCE_DOCS_DIR=./data/sources
CHROMA_PERSIST_DIR=./data/chroma

# Embedding model (used only when AI_DEMO_MODE=false)
EMBEDDING_MODEL=BAAI/bge-m3

# Ollama (used only when AI_DEMO_MODE=false)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

HOST=0.0.0.0
PORT=8000
